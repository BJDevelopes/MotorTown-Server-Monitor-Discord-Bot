# ─────────────────────────────────────────────────────────────
# Motor Town Discord Bot — configuration
#
# Copy this file to `.env` (in the same folder as bot.js) and fill it in.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Discord (required) ───────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here

# Optional nickname the bot gives itself in every server it joins
BOT_NICKNAME=Server Monitor

# ── Game server Web API (required) ───────────────────────────
# Must match bEnableHostWebAPIServer / HostWebAPIServerPassword /
# HostWebAPIServerPort in your DedicatedServerConfig.json.
#
# SECURITY: the Web API is plain HTTP and the password travels in the URL.
# Do not expose this port to the internet — run the bot on the same machine
# or LAN as the game server, or put it behind an HTTPS reverse proxy.
API_HOST=your.server.ip.address
API_PORT=8080
API_PASSWORD=your_api_password_here

# How long to wait for the game server before giving up, in milliseconds
API_TIMEOUT=10000

# ── Bot admins (required) ────────────────────────────────────
# Comma-separated Discord User IDs allowed to run admin commands.
# Enable Developer Mode in Discord, then right-click a user → Copy User ID.
# Anyone added later with /addadmin is saved to admin_data.json automatically.
ADMIN_USER_IDS=120343643381956608

# ── /join instructions (optional) ────────────────────────────
# Without JOIN_SERVER_NAME, the /join command tells users it isn't configured.
# Falls back to SERVER_NAME below if JOIN_SERVER_NAME is not set.
JOIN_SERVER_NAME=Example Town
JOIN_PASSWORD=
JOIN_LINK=

# ── Player mapping (optional) ────────────────────────────────
# Show friendly names instead of raw IDs in /players and the join/leave feed.
# Format: unique_id:name|unique_id:DiscordUserID|unique_id:name
# A 17-19 digit value is treated as a Discord User ID and resolved to that
# member's server nickname (falling back to their username).
# Examples:
#   12345:Jerry                    (Custom name)
#   67890:120343643381956608       (Discord User ID)
#   11111:Bob the Builder          (Custom name with spaces)
PLAYER_MAPPING=

# ── Server monitor dashboard (optional) ──────────────────────
# A single auto-updating status embed the bot posts and then edits in place.
# Leave MONITOR_CHANNEL_ID empty to disable.
MONITOR_CHANNEL_ID=
MONITOR_INTERVAL=60

# Shown in the monitor embed
SERVER_NAME=Example Town
LOGO_URL=https://i.imgur.com/v3P4f2y.jpeg

# ── Player join/leave feed (optional) ────────────────────────
# Posts a message whenever someone joins or leaves the server.
# The Web API cannot read in-game chat, so this is the closest live feed
# available. Leave empty to disable.
PLAYER_FEED_CHANNEL_ID=
PLAYER_FEED_INTERVAL=60

# ── Reserved (optional) ──────────────────────────────────────
# Chat mirroring is not possible yet: the Motor Town Web API still has no
# endpoint for reading in-game chat. This is kept for a future API update.
CHAT_CHANNEL_ID=
